# Local backend configuration. Copy to backend/.env only when running the
# backend outside Docker; never commit the copied file.
ML_PORT=3004
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACTIVITY_DATABASE_URL=postgresql://agent:change-this-before-deployment@localhost:5432/ai_eda_assistant
ACTIVITY_DB_CONNECT_TIMEOUT=1
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Configure providers in agentic-layer/.env. Leave values empty when the
# optional hosted assistant is not in use.
LONGCAT_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

