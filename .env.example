# Copy to .env and set values appropriate for the deployment environment.
COMPOSE_PROJECT_NAME=ai-eda-assistant
NGINX_PORT=8888

# PostgreSQL is internal to the Compose network. Use a strong unique password
# outside local development.
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-this-before-deployment
POSTGRES_DB=ai_eda_assistant

# Browser origins permitted to call the backend directly. The public Nginx
# endpoint is same-origin and does not need to be listed.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set true when HTTPS terminates before the application.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
ACTIVITY_DB_CONNECT_TIMEOUT=1
